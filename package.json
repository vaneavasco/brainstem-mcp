{
  "name": "brainstem-mcp",
  "version": "0.1.0",
  "description": "Multi-tenant MCP vault server (Google Drive / local FS) for Claude",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run",
    "dev": "node --watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test:watch": "vitest",
    "heroku-postbuild": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vaneavasco/brainstem-mcp.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/vaneavasco/brainstem-mcp/issues"
  },
  "homepage": "https://github.com/vaneavasco/brainstem-mcp#readme",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "diff": "^9.0.0",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
