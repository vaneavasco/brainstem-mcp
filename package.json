{
  "name": "brainstem-mcp",
  "version": "0.1.0",
  "description": "Single-user, self-hosted MCP vault server for Claude (Obsidian vault, Docker, Cloudflare tunnel)",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run",
    "dev": "node --watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test:watch": "vitest",
    "heroku-postbuild": "npm run build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "docker:smoke": "bash scripts/docker-smoke.sh",
    "mcp:call": "node scripts/mcp-call.ts",
    "brainstem": "node src/cli/brainstem.ts",
    "setup": "node src/cli/brainstem.ts setup",
    "up": "node src/cli/brainstem.ts up",
    "url": "node src/cli/brainstem.ts url",
    "status": "node src/cli/brainstem.ts status",
    "down": "node src/cli/brainstem.ts down",
    "logs": "node src/cli/brainstem.ts logs",
    "revoke-all": "node src/cli/brainstem.ts revoke-all"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vaneavasco/brainstem-mcp.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/vaneavasco/brainstem-mcp/issues"
  },
  "homepage": "https://github.com/vaneavasco/brainstem-mcp#readme",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@inquirer/prompts": "8.7.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "chokidar": "^5.0.0",
    "commander": "15.0.0",
    "date-fns": "^4.4.0",
    "diff": "^9.0.0",
    "express": "^5.2.1",
    "picomatch": "^4.0.7",
    "pino": "^10.3.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/picomatch": "^4.0.3",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
