#!/usr/bin/env bash
# brainstem — one-command launcher. All logic lives in src/cli/brainstem.ts; this only
# makes sure node + docker exist and dependencies are installed, then delegates.
# Set BRAINSTEM_SKIP_INSTALL=1 to skip the dependency-install step entirely (used by
# the launcher test, so a stale-lockfile check never runs `npm ci --omit=dev` mid-suite).
set -euo pipefail

# Resolve the directory this script lives in. `readlink -f` is GNU-only (no `-f` on
# macOS/BSD), so we use `dirname` + `pwd -P` instead — portable, and it resolves any
# `..`/symlinks in the *path leading to* this file. It does not chase the launcher
# itself if that file is a symlink; that's an accepted edge case, not a supported setup.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
cd "$SCRIPT_DIR"

if ! command -v node >/dev/null 2>&1; then
  echo "Node.js 24 is required. Install: https://nodejs.org/en/download (Linux: NodeSource setup_24.x; macOS: brew install node@24)" >&2
  exit 1
fi
major="$(node -p 'process.versions.node.split(".")[0]')"
if [ "$major" -lt 24 ]; then
  echo "Node.js $major found; version 24 or newer is required." >&2
  exit 1
fi
if ! command -v docker >/dev/null 2>&1; then
  echo "Docker is required. Install Docker Desktop (https://docs.docker.com/desktop/) or Docker Engine + Compose v2." >&2
  exit 1
fi
# Fresh iff node_modules/.package-lock.json exists and is not older than package-lock.json
# (a missing marker/dir makes statSync throw, caught as -1, so this also covers a fresh
# checkout with no node_modules at all). The check is a byte-identical `node -e` one-liner
# in brainstem.cmd, so the two launchers agree exactly instead of diverging by platform.
if [ "${BRAINSTEM_SKIP_INSTALL:-}" != "1" ]; then
  if ! node -e "function s(p){try{return require('fs').statSync(p).mtimeMs}catch(e){return -1}};process.exit(Math.sign(s('package-lock.json')-s('node_modules/.package-lock.json'))===1?1:0)"; then
    echo "Installing dependencies…" >&2
    npm ci --omit=dev --silent --no-audit --no-fund
  fi
fi
exec node src/cli/brainstem.ts "$@"
