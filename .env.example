# brainstem-mcp — created/completed by `./brainstem setup`. Never commit .env.
# --- required (setup fills these) ---
OWNER_SECRET=
VAULT_PATH=
# --- tunnel: cloudflare (stable URL, needs TUNNEL_TOKEN + PUBLIC_URL) | quick (random URL each start) | none (Claude Code only)
TUNNEL_MODE=quick
TUNNEL_TOKEN=
PUBLIC_URL=
PUBLIC_URL_FILE=/vault/_brainstem/public-url
ALLOW_INSECURE_PUBLIC_URL=false
# --- vault ---
VAULT_TIMEZONE=
VAULT_WATCH_POLL_MS=
# Registers only the read-only tools (both HTTP and stdio); stdio also takes --read-only.
# Empty/false = every tool, as today.
VAULT_READ_ONLY=
# How often (ms) the in-memory index re-checks the whole vault for drift a watcher event may
# have missed. Empty = 300000 (5 min); 0 disables the background sweep; otherwise at least 10000.
VAULT_RECONCILE_MS=
DAILY_NOTES_FOLDER=
DAILY_NOTES_FORMAT=yyyy-MM-dd
# Body a freshly created daily note starts from ({{date}}, {{title}}, {{date:FMT}} placeholders).
# Empty = use the built-in default: frontmatter with type: daily and date: {{date}}, plus a # {{title}} heading.
DAILY_NOTES_TEMPLATE=
# Comma-separated frontmatter keys vault_analyze reports as missing (empty = check nothing)
REQUIRED_FRONTMATTER=
# Max size in bytes for vault_write_binary attachments (images/audio/video/PDF). Empty = 8 MiB.
# Text writes (vault_write etc.) are unaffected — they stay capped at 1 MiB.
MAX_BINARY_BYTES=
# STATE_DIR (auth state location) is test/dev-only and is NOT supported under Docker,
# where state always lives in the bind-mounted vault at /vault/_brainstem. For the stdio server
# it overrides only where the transaction journal (and, later, the index cache) lives; the
# owner's _brainstem/instructions.md always stays inside the vault regardless. Any STATE_DIR
# inside the vault is refused at boot (exit 1) EXCEPT exactly <vault>/_brainstem, the one
# grandfathered dev/test spot (it's vault content already, per the line above).
# BRAINSTEM_STATE_HOME (stdio only): absolute path for the base of the machine-local folder the
# stdio server keeps its own working state in (never inside the vault — see README). Empty = the
# OS default (~/.local/state/brainstem on Linux, ~/Library/Application Support/brainstem on
# macOS, %LOCALAPPDATA%\brainstem\State on Windows). A value that would resolve inside the vault
# (or put the vault inside it) is refused at boot (exit 1, one stderr line) before anything is
# created there.
BRAINSTEM_STATE_HOME=
# BRAINSTEM_INDEX_CACHE=off (stdio only) disables the machine-local frontmatter-index cache
# entirely — the server always does a cold fill, same as before this cache existed. Empty/unset =
# on. The cache is a hint, never a source (see README): safe to delete at any time.
BRAINSTEM_INDEX_CACHE=
# BRAINSTEM_CACHE_HOME (stdio only): absolute path for the base of the machine-local folder the
# index cache lives in — a different folder from BRAINSTEM_STATE_HOME above, never inside the
# vault. Empty = the OS default (~/.cache/brainstem on Linux, ~/Library/Caches/brainstem on
# macOS, %LOCALAPPDATA%\brainstem\Cache on Windows). Unlike BRAINSTEM_STATE_HOME, a folder that
# cannot be created or written here is never fatal: the server runs without a cache instead — and
# a value that would resolve inside the vault (or put the vault inside it), unlike the state
# folder, is handled the same way: no exception, just a warning line and no cache.
BRAINSTEM_CACHE_HOME=
# --- server ---
PORT=3000
LOG_LEVEL=info
MCP_LEGACY_MODE=stateless
CIMD_ALLOWED_HOSTS=claude.ai,claude.com
ACCESS_TOKEN_TTL_S=3600
REFRESH_TOKEN_TTL_S=7776000
# --- host (Linux only; setup fills) ---
HOST_UID=
HOST_GID=
